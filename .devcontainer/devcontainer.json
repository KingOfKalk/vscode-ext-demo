{
  "name": "vscode-ext-demo",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5.2.7-26-trixie",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {},
    "ghcr.io/devcontainers-extra/features/claude-code:2.0.3": {}
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "noVNC",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "scripts/install-system-deps.sh --live && npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "vitest.explorer"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "git.openRepositoryInParentFolders": "always",
        "telemetry.telemetryLevel": "off",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(gh repo edit *--visibility*)",
      "Bash(gh repo fork *)",
      "Bash(gh repo delete *)",
      "Bash(gh gist *)",
      "Bash(gh api *gists*)",
      "Bash(gh repo create *--public*)",
      "Bash(gh repo create *--internal*)",
      "Bash(gh api *visibility*)",
      "Bash(gh api *private=false*)"
    ]
  }
}
